{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "outDir": "dist/types",
    "baseUrl": "./src"
  },
  "exclude": [
    "tests",
    "**/*.test.ts",
    "tsdown.config.ts",
    "viteest.config.ts",
    "dist",
    "*.js",
  ],
  "include": ["src"]
}
